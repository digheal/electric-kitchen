---
interface Props { title?: string; description?: string }
const { title, description = 'A public list of commercial kitchens that cook without gas.' } = Astro.props;
const fullTitle = title ? `${title} · All-Electric Kitchens` : 'All-Electric Kitchens';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%230b6b6b'/%3E%3Cpath d='M18 5 9 18h6l-1 9 9-13h-6z' fill='%23f6b93b'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">All-Electric Kitchens</a>
        <nav aria-label="Main">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
          <a href="/browse/" aria-current={path.startsWith('/browse') ? 'page' : undefined}>Browse</a>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="site-footer"><div class="wrap">Kitchens that cook without gas. Listings are reviewed before they appear.</div></footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf7f2; --surface: #ffffff; --text: #1c2625; --muted: #56625f; --line: #ddd6ca;
    --accent: #0b6b6b; --accent-text: #ffffff; --spark: #f6b93b;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111919; --surface: #1a2423; --text: #eef2f0; --muted: #a6b3af; --line: #2d3b39;
      --accent: #5cc7c0; --accent-text: #0c1514; --spark: #f6b93b;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 1rem/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; }
  h1, h2, h3, .brand { font-family: Georgia, "Times New Roman", serif; line-height: 1.2; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.8rem); margin: 0 0 .5rem; }
  h2 { font-size: 1.4rem; margin: 2rem 0 .75rem; }
  h3 { font-size: 1.1rem; margin: 0; }
  a { color: var(--accent); }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid var(--spark); outline-offset: 2px; }
  .wrap { max-width: 64rem; margin: 0 auto; padding: 0 1rem; }
  .skip { position: absolute; left: -999px; top: 0; background: var(--accent); color: var(--accent-text); padding: .5rem 1rem; z-index: 1000; }
  .skip:focus { left: 0; }
  .site-header { border-bottom: 1px solid var(--line); background: var(--surface); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.5rem; flex-wrap: wrap; }
  .brand { font-weight: 700; font-size: 1.15rem; text-decoration: none; color: var(--text); }
  nav a { margin-left: 1rem; color: var(--text); text-decoration: none; padding: .5rem 0; display: inline-block; }
  nav a[aria-current] { border-bottom: 3px solid var(--spark); }
  main { padding-top: 1.5rem; padding-bottom: 3rem; min-height: 60vh; }
  .site-footer { border-top: 1px solid var(--line); color: var(--muted); padding: 1.25rem 0; font-size: .9rem; }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 40rem; margin: 0 0 1rem; }
  .count { display: inline-block; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: .25rem .9rem; font-weight: 600; }
  .map { height: 22rem; border-radius: .75rem; border: 1px solid var(--line); margin: 1rem 0; z-index: 0; }
  .map.small { height: 16rem; }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: .75rem; padding: 1rem; }
  .card a { text-decoration: none; }
  .card a:hover { text-decoration: underline; }
  .meta { color: var(--muted); margin: .25rem 0 .5rem; font-size: .95rem; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .35rem; }
  .tags li { background: color-mix(in srgb, var(--accent) 14%, transparent); border-radius: 999px; padding: .1rem .65rem; font-size: .85rem; }
  .filters { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); margin: 1rem 0; }
  .filters label { display: block; font-size: .9rem; font-weight: 600; margin-bottom: .25rem; }
  input, select { width: 100%; font: inherit; padding: .6rem .7rem; min-height: 2.75rem; border: 1px solid var(--muted); border-radius: .5rem; background: var(--surface); color: var(--text); }
  .status, .empty { color: var(--muted); }
  dl.facts { display: grid; grid-template-columns: max-content 1fr; gap: .4rem 1.25rem; margin: 1rem 0; }
  dl.facts dt { font-weight: 600; } dl.facts dd { margin: 0; }
  .pin span { display: block; width: 22px; height: 22px; border-radius: 50%; background: var(--accent); border: 3px solid #fff; box-shadow: 0 1px 4px rgba(0,0,0,.5); }
  .pin:focus-visible span { outline: 3px solid var(--spark); }
  .leaflet-container { font-family: inherit; }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; scroll-behavior: auto !important; } .leaflet-fade-anim .leaflet-popup, .leaflet-zoom-anim .leaflet-zoom-animated { transition: none !important; } }
</style>
