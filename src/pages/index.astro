---
import Base from '../layouts/Base.astro';
---
<Base>
  <section class="hero" aria-label="Globe of all-electric kitchens">
    <canvas id="dots" class="hero-dots" aria-hidden="true"></canvas>
    <div id="map" class="hero-map" role="region" aria-label="Interactive globe. Each yellow dot is an all-electric kitchen. The same kitchens are listed in the buttons along the bottom."></div>
    <div class="hero-card">
      <h1>Kitchens that cook without gas</h1>
      <p class="lead">A public list of commercial kitchens that run entirely on electric equipment. Proof that it works.</p>
      <p class="count" id="count" aria-live="polite">Loading…</p>
      <a class="btn" href="/browse/">Browse all kitchens</a>
    </div>
    <button type="button" class="spin-btn" id="spin" aria-pressed="false">Pause animation</button>
    <ul class="rail" id="rail" aria-label="Jump to a kitchen"></ul>
    <p class="error" id="error" role="alert" hidden></p>
  </section>
  <div class="wrap">
    <h2>Newest additions</h2>
    <ul class="cards" id="newest"></ul>
  </div>
</Base>

<script>
  import { el, fetchKitchens, kitchenCard } from '../lib/shared';
  import { showGlobe } from '../scripts/map';
  import { startGrid } from '../scripts/grid';

  const count = document.getElementById('count')!;
  const error = document.getElementById('error')!;

  try {
    const kitchens = await fetchKitchens();
    count.textContent = `${kitchens.length} all-electric ${kitchens.length === 1 ? 'kitchen' : 'kitchens'} listed`;
    const grid = startGrid(document.querySelector<HTMLElement>('.hero')!, document.getElementById('dots') as HTMLCanvasElement);
    const hero = showGlobe(document.getElementById('map')!, kitchens, document.getElementById('spin') as HTMLButtonElement, (paused) => grid.setPaused(paused));
    document.getElementById('rail')!.append(
      ...kitchens
        .filter((k) => k.lat != null)
        .map((k) => {
          const b = el('button', { type: 'button' }, k.name);
          b.addEventListener('click', () => hero.focus(k));
          return el('li', {}, b);
        }),
    );
    document.getElementById('newest')!.append(...kitchens.slice(0, 6).map(kitchenCard));
  } catch {
    count.textContent = '';
    error.hidden = false;
    error.textContent = 'Sorry, the kitchen list could not be loaded. Please try again later.';
  }
</script>
