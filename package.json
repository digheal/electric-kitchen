{
  "name": "electric-kitchen",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "check": "astro check && tsc -p src/worker",
    "cf-typegen": "wrangler types",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "astro": "^7.4.1",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/leaflet": "^1.9.22",
    "typescript": "^6.0.3",
    "wrangler": "^4.155.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
