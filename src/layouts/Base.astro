---
interface Props { title?: string; description?: string }
const { title, description = 'A public list of commercial kitchens that cook without gas.' } = Astro.props;
const fullTitle = title ? `${title} · All-Electric Kitchens` : 'All-Electric Kitchens';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%230b6b6b'/%3E%3Cpath d='M18 5 9 18h6l-1 9 9-13h-6z' fill='%23f6b93b'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/"><span class="bolt" aria-hidden="true">⚡</span> All-Electric Kitchens</a>
        <nav aria-label="Main">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Globe</a>
          <a href="/browse/" aria-current={path.startsWith('/browse') ? 'page' : undefined}>Browse</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="wrap">Kitchens that cook without gas. Every listing is reviewed before it appears.</div></footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f7f5; --surface: #ffffff; --text: #0f1b1a; --muted: #55625f; --line: #e0e4e1;
    --accent: #0b6b6b; --accent-text: #ffffff; --spark: #f6b93b; --space: #060b10;
    --hero-bg: var(--bg); --grid: rgba(15,27,26,.09);
    --glass: rgba(255,255,255,.78); --glass-text: #0f1b1a; --glass-muted: #46544f; --glass-line: rgba(15,27,26,.12); --glass-hover: #ffffff; --glass-accent: #0b6b6b;
    --radius: 1rem; --shadow: 0 1px 2px rgba(15,27,26,.06), 0 8px 24px rgba(15,27,26,.06);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0b1213; --surface: #131c1d; --text: #eef3f1; --muted: #a2b0ac; --line: #243230;
      --hero-bg: var(--bg); --grid: rgba(255,255,255,.07);
      --glass: rgba(10,18,24,.78); --glass-text: #ffffff; --glass-muted: rgba(255,255,255,.82); --glass-line: rgba(255,255,255,.16); --glass-hover: #1d3a40; --glass-accent: #f6b93b;
      --accent: #5cc7c0; --accent-text: #0a1413; --shadow: 0 1px 2px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.35);
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 1rem/1.6 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
  h1, h2, h3 { font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; }
  h1 { font-size: clamp(2rem, 5.5vw, 3.25rem); margin: 0 0 .6rem; }
  h2 { font-size: 1.5rem; margin: 2.5rem 0 1rem; }
  h3 { font-size: 1.05rem; margin: 0; letter-spacing: -0.01em; }
  a { color: var(--accent); }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid var(--spark); outline-offset: 2px; }
  .wrap { max-width: 68rem; margin: 0 auto; padding: 0 1.25rem; }
  .skip { position: absolute; left: -999px; top: 0; background: var(--accent); color: var(--accent-text); padding: .5rem 1rem; z-index: 1000; }
  .skip:focus { left: 0; }

  .site-header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.5rem; }
  .brand { font-weight: 700; letter-spacing: -0.02em; text-decoration: none; color: var(--text); }
  .bolt { color: var(--spark); }
  nav a { margin-left: .25rem; color: var(--text); text-decoration: none; padding: .45rem .9rem; display: inline-block; border-radius: 999px; font-weight: 500; }
  nav a:hover { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  nav a[aria-current] { background: var(--accent); color: var(--accent-text); }
  main { min-height: 60vh; padding-bottom: 3rem; }
  .page { padding-top: 2rem; }
  .site-footer { border-top: 1px solid var(--line); color: var(--muted); padding: 1.5rem 0; font-size: .9rem; }

  .btn { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.3rem; border-radius: 999px; background: var(--spark); color: #1b1300; font-weight: 600; text-decoration: none; border: 0; cursor: pointer; font: inherit; font-weight: 600; }
  .btn:hover { filter: brightness(1.05); }

  /* Globe hero */
  .hero { position: relative; height: min(82svh, 48rem); min-height: 32rem; background: var(--hero-bg); overflow: hidden; }
  /* Faint grid that fades out toward the edges */
  .hero::before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px); background-size: 44px 44px; background-position: center; -webkit-mask-image: radial-gradient(ellipse 62% 62% at 62% 48%, #000 15%, transparent 100%); mask-image: radial-gradient(ellipse 62% 62% at 62% 48%, #000 15%, transparent 100%); pointer-events: none; }
  .hero-map { position: absolute; inset: 0; }
  .hero-card { position: absolute; z-index: 5; top: 1.25rem; left: 1.25rem; max-width: 24rem; padding: 1.4rem 1.5rem; color: var(--glass-text); border-radius: 1.25rem; background: var(--glass); border: 1px solid var(--glass-line); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: var(--shadow); }
  .hero-card h1 { font-size: clamp(1.7rem, 4.4vw, 2.5rem); color: var(--glass-text); }
  .hero-card p { margin: 0 0 1rem; color: var(--glass-muted); }
  .hero-card .count { font-weight: 600; color: var(--glass-accent); margin-bottom: 1rem; }
  .spin-btn { position: absolute; z-index: 5; top: 1.25rem; right: 4.2rem; min-height: 2.5rem; padding: 0 1rem; border-radius: 999px; border: 1px solid var(--glass-line); background: var(--glass); color: var(--glass-text); font: inherit; font-size: .9rem; cursor: pointer; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .rail { position: absolute; z-index: 5; left: 0; right: 0; bottom: 1.7rem; display: flex; gap: .6rem; overflow-x: auto; margin: 0; padding: .4rem 1.25rem .6rem; list-style: none; scrollbar-width: thin; }
  .rail button { white-space: nowrap; min-height: 2.75rem; padding: 0 1.1rem; border-radius: 999px; border: 1px solid var(--glass-line); background: var(--glass); color: var(--glass-text); font: inherit; font-size: .92rem; cursor: pointer; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .rail button:hover { background: var(--glass-hover); }
  .hero .error { position: absolute; z-index: 6; inset: auto 1.25rem 5rem; color: var(--glass-text); }
  .maplibregl-popup-content { padding: 1rem 1.1rem; border-radius: .9rem; font-family: inherit; color: #0f1b1a; }
  .popup { display: grid; gap: .2rem; }
  .popup span { color: #4a5754; font-size: .9rem; }
  .popup a { color: #0b6b6b; font-weight: 600; }
  .maplibregl-ctrl-group { border-radius: .75rem; }
  .hero .maplibregl-ctrl-attrib { background: var(--glass); color: var(--glass-muted); }
  .hero .maplibregl-ctrl-attrib a { color: var(--glass-text); }

  .map-small { position: relative; height: 18rem; border-radius: var(--radius); overflow: hidden; margin: 1.25rem 0; border: 1px solid var(--line); }
  .map-small > div { position: absolute; inset: 0; }

  /* Cards and filters */
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; box-shadow: var(--shadow); transition: transform .15s ease; }
  .card:hover { transform: translateY(-2px); }
  .card a { color: var(--text); text-decoration: none; }
  .card a:hover { color: var(--accent); }
  .meta { color: var(--muted); margin: .3rem 0 .8rem; font-size: .95rem; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .tags li { background: color-mix(in srgb, var(--accent) 13%, transparent); border-radius: 999px; padding: .15rem .7rem; font-size: .84rem; }
  .filters { display: grid; gap: .9rem; grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr)); margin: 1.25rem 0 1.5rem; padding: 1.1rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .filters label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: .3rem; }
  input, select { width: 100%; font: inherit; padding: .6rem .8rem; min-height: 2.75rem; border: 1px solid var(--muted); border-radius: .7rem; background: var(--bg); color: var(--text); }
  .status, .empty { color: var(--muted); }
  dl.facts { display: grid; grid-template-columns: max-content 1fr; gap: .5rem 1.5rem; margin: 1.25rem 0; }
  dl.facts dt { font-weight: 600; } dl.facts dd { margin: 0; }

  @media (max-width: 640px) {
    .hero { min-height: 30rem; }
    .hero-card { right: 4rem; max-width: none; padding: 1.1rem 1.2rem; }
    .hero-card .lead { display: none; }
    .spin-btn { top: auto; right: 1.25rem; bottom: 5.3rem; }
    nav a { padding: .45rem .7rem; }
  }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }
</style>
