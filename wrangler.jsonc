{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "electric-kitchen",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker code. Everything else is served straight from static files.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // The database ID is not a secret. It only names the database inside our own account.
  "d1_databases": [
    { "binding": "DB", "database_name": "electric-kitchen-db", "database_id": "ba50ed2c-6a8d-4e14-9fb5-4318fbcc8998", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "electric-kitchen-photos" }
  ],
  "observability": { "enabled": true }
}
